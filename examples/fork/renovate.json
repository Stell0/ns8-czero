{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "pep621"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "Stell0/ns8-czero"
      ],
      "versioning": "regex:^core-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "allowedVersions": ">=core-v0.24.1 <core-v0.25.0",
      "automerge": false
    }
  ],
  "ignoreDeps": [
    "python"
  ]
}
