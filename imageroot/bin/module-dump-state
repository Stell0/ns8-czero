"""Prepare an atomic PostgreSQL dump for native NS8 Restic backup."""
import json
import os
from pathlib import Path
import subprocess
import agent


def active(unit):
    return subprocess.run(['systemctl','--user','is-active','--quiet',unit]).returncode == 0


state = Path(os.environ['AGENT_STATE_DIR'])
pod_active = active('czero-pod.service')
db_active = active('czero-postgres.service')
metadata = {'format': 1, 'app_active': active('czero.service'),
    'app_enabled': subprocess.run(['systemctl','--user','is-enabled','--quiet','czero.service']).returncode == 0,
    'scheduler_active': active('czero-worker.timer')}
old_umask = os.umask(0o077)
failed = False
try:
    # Quiesce file writers across both the SQL dump and Restic volume copy.
    with agent.safe_open(str(state / 'backup-worker-state.json')) as output:
        json.dump({'scheduler_active':metadata['scheduler_active'], 'app_active':metadata['app_active']},output)
    subprocess.run(['systemctl','--user','stop','czero-worker.timer','czero-worker.service'],check=True)
    subprocess.run(['systemctl','--user','stop','czero.service'],check=True)
    if not db_active:
        subprocess.run(['systemctl','--user','start','czero-postgres.service'],check=True)
    with agent.safe_open(str(state / 'czero.pg_dump'), 'wb') as output:
        subprocess.run(['podman','exec','czero-postgres','pg_dump','-U','czero',
                        '--format=custom','czero'],stdout=output,check=True)
    with agent.safe_open(str(state / 'backup-metadata.json')) as output:
        json.dump(metadata,output)
except Exception:
    failed = True
    (state / 'czero.pg_dump').unlink(missing_ok=True)
    (state / 'backup-metadata.json').unlink(missing_ok=True)
    raise
finally:
    os.umask(old_umask)
    if not db_active:
        subprocess.run(['systemctl','--user','stop','czero-postgres.service'],check=True)
    if not pod_active:
        subprocess.run(['systemctl','--user','stop','czero-pod.service'],check=True)
    if failed:
        if metadata['app_active']:
            subprocess.run(['systemctl','--user','start','czero.service'],check=True)
        subprocess.run(['systemctl','--user','start' if metadata['scheduler_active'] else 'stop','czero-worker.timer'],check=True)
        (state / 'backup-worker-state.json').unlink(missing_ok=True)
