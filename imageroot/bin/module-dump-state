import runpy
import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from czero_custom_apps import Host

host = Host()
with host.locked():
	try:
		host.quiesce('backup')
		runpy.run_path(str(Path(__file__).with_name('czero-dump-database')))
		host.export()
	except BaseException:
		runpy.run_path(str(Path(__file__).with_name('czero-cleanup-database')))
		host.resume()
		raise
