import os
import secrets
from pathlib import Path
import agent

path = Path(os.environ["AGENT_STATE_DIR"]) / "passwords.env"
with agent.exclusive_file_lock(str(path)):
    if not path.exists():
        previous_umask = os.umask(0o077)
        try:
            password = secrets.token_urlsafe(32)
            with agent.safe_open(str(path)) as target:
                print(f"POSTGRES_PASSWORD={password}", file=target)
                print(f"CZERO_DATABASE_URL=postgresql+psycopg://czero:{password}@127.0.0.1:5432/czero", file=target)
        finally:
            os.umask(previous_umask)
    # Never rotate an initialized database password during configure/update.
    path.chmod(0o600)
