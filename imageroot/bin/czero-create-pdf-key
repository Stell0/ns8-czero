#!/usr/bin/env python3
# Copyright (C) 2026 C0 contributors; SPDX-License-Identifier: GPL-3.0-or-later
"""Provision or validate the private PDF password sealing key."""
import os
from pathlib import Path
import secrets
import stat
import subprocess
import tempfile

state = Path(os.environ['AGENT_STATE_DIR'])
key = state / 'pdf-unlock.key'
if not key.exists() and not key.is_symlink():
    fd, staging = tempfile.mkstemp(prefix='.pdf-unlock-', dir=state)
    try:
        with os.fdopen(fd, 'wb') as output:
            output.write(secrets.token_bytes(32))
            output.flush()
            os.fsync(output.fileno())
        try:
            os.link(staging, key)
        except FileExistsError:
            pass
    finally:
        os.unlink(staging)
fd = os.open(key, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
with os.fdopen(fd, 'rb') as source:
    info = os.fstat(source.fileno())
    if (not stat.S_ISREG(info.st_mode) or info.st_size != 32
            or info.st_uid != os.geteuid() or info.st_mode & 0o077):
        raise SystemExit('Invalid PDF unlock key')

subprocess.run(['podman', 'secret', 'create', '--replace', 'czero-pdf-unlock', str(key)],
               check=True, stdout=subprocess.DEVNULL)
