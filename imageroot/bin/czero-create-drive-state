"""Provision a private optional Podman env file on install, upgrade and restore."""
import os
import stat
from pathlib import Path

path = Path(os.environ['AGENT_STATE_DIR']) / 'google-drive.env'
fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CREAT, 0o600)
with os.fdopen(fd, 'rb') as stream:
    info = os.fstat(stream.fileno())
    if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_size > 16409:
        raise SystemExit('Invalid Google Drive state file')
    lines = stream.read(16410).splitlines()
    if lines and (len(lines) != 1 or not lines[0].startswith(b'CZERO_GOOGLE_DRIVE_CONFIG=')):
        raise SystemExit('Invalid Google Drive configuration entry')
    os.fchmod(stream.fileno(), 0o600)
