#!/usr/bin/env python3
# Copyright (C) 2026 C0 contributors; SPDX-License-Identifier: GPL-3.0-or-later
"""Build a current native binding snapshot, then invoke the existing app image."""
import json
import os
from pathlib import Path
import subprocess
import select
import signal
import re
import time
import sys
from uuid import UUID,uuid4

import agent
from agent.ldapproxy import Ldapproxy
from agent.ldapclient import Ldapclient
from czero_personal_data import read,discover,private_write,private_read,identity_binding,directory_user,current_directory_owner,credentials_unchanged

state=Path(os.environ['AGENT_STATE_DIR'])
invocation=None
credentials_copy=None
credentials_snapshot=None
signal.signal(signal.SIGTERM,lambda *_:sys.exit(143))
try:
    # Copies can remain after SIGKILL. All runner invocations are bounded to 150s.
    for stale in (*state.glob('personal-data-runtime-*.json'),*state.glob('.personal-data*.pending')):
        try:
            if time.time()-stale.stat().st_mtime>300:stale.unlink(missing_ok=True)
        except FileNotFoundError:pass
    fence_only='--fence-only' in sys.argv
    pending_configuration=state/'personal-data-pending.json'
    config=json.loads(pending_configuration.read_text()) if fence_only and pending_configuration.exists() else read()
    previous={}
    runtime=state/'personal-data-runtime.json'
    if runtime.exists():previous=json.loads(runtime.read_text())
    auth=agent.read_envfile(str(state/'auth.env'))
    issuer,identity_changed=identity_binding(auth,previous)
    snapshot={'issuer':issuer,'configuration':config,'directory':[],'directory_complete':False,'provider_verified':False,'provider_mismatches':[]}
    if fence_only:
        snapshot['provider_id']=previous.get('provider_id') or str(UUID(int=0))
    elif config['enabled'] and not identity_changed:
        rdb=agent.redis_connect(use_replica=True)
        proxy=Ldapproxy()
        domain=os.environ['CZERO_USER_DOMAIN']
        parameters=proxy.get_domain(domain)
        provider,options=discover(rdb,proxy,domain)
        snapshot['provider_id']=provider
        snapshot['provider_verified']=True
        snapshot['endpoints']={}
        for kind in ('nethvoice','webtop'):
            if not config[kind]:continue
            found=next((row for row in options[kind] if row['id']==config[kind]),None)
            if found is None:
                # Disappearance or temporary discovery failure is not verified mismatch.
                snapshot['provider_verified']=False
                if config[kind] in options['_mismatches'][kind]:
                    snapshot['provider_mismatch']=True
                    snapshot['provider_mismatches'].append(kind)
                continue
            snapshot['endpoints'][kind]=found['endpoint']
            if kind=='webtop':
                snapshot['mail_domain']=rdb.hget('module/'+found['label']+'/environment','MAIL_DOMAIN')
        if snapshot['provider_verified']:
            client=Ldapclient.factory(**parameters)
            users=client.list_users()
            if isinstance(users,dict):names=list(users)
            elif isinstance(users,list):
                names=[u if isinstance(u,str) else u.get('user') if isinstance(u,dict) else None for u in users]
            else:raise ValueError('directory_unavailable')
            if len(names)>1000 or any(not isinstance(n,str) or not n for n in names):raise ValueError('directory_unavailable')
            for name in names:
                snapshot['directory'].append(directory_user(client,parameters['schema'],name))
            snapshot['directory_complete']=True
    elif previous.get('provider_id'):
        snapshot['provider_id']=previous['provider_id']
        if config['enabled'] and identity_changed:
            snapshot.update(provider_mismatch=True,directory_mismatch=True)
    else:
        # Core owns the actual mapping. Missing native snapshots cannot skip cleanup.
        snapshot['provider_id']=str(UUID(int=0))
    if not fence_only:private_write(runtime,snapshot)
    secret=state/'personal-data-secrets.json'
    invocation=state/('personal-data-runtime-'+uuid4().hex+'.json')
    private_write(invocation,snapshot)
    protected=[str(invocation)]
    if not fence_only and '--configure-only' not in sys.argv and config['enabled'] and snapshot['provider_verified']:
        credentials_copy=invocation.with_suffix('.credentials.json')
        credentials_snapshot=private_read(secret) if secret.exists() else {}
        private_write(credentials_copy,credentials_snapshot)
        protected.append(str(credentials_copy))
    # Match the existing image UID without changing host canonical-file ownership.
    subprocess.run(['podman','unshare','chown','10001:10001',*protected],check=True,
        stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=10)
    name='czero-personal-data-fence' if fence_only else ('czero-personal-data-configure' if '--configure-only' in sys.argv else 'czero-personal-data-run')
    cidfile=invocation.with_suffix('.cid')
    command=['podman','run','--rm','--log-driver=none','--name',name,'--cidfile='+str(cidfile),
        '--memory=1g','--memory-swap=2g','--pids-limit=256','--cap-drop=ALL','--security-opt=no-new-privileges',
        '--pod-id-file='+os.environ['XDG_RUNTIME_DIR']+'/czero.pod-id',
        '--env-file='+str(state/'passwords.env'),'--env-file='+str(state/'auth.env'),'--env-file='+str(state/'retrieval.env'),
        '--volume=czero-sources:/var/lib/czero/sources:z',
        '--volume='+str(invocation)+':/var/lib/czero/personal-data-runtime.json:ro,Z',
        '--entrypoint=python',os.environ['CZERO_APP_IMAGE'],'-m','czero_app.personal_data.runner']
    if credentials_copy is not None:
        command.insert(command.index('--entrypoint=python'),'--volume='+str(credentials_copy)+':/var/lib/czero/personal-data-secrets.json:ro,Z')
    if fence_only:command.append('--fence-only')
    elif '--configure-only' in sys.argv:command.append('--configure-only')
    process=subprocess.Popen(command,stdin=subprocess.PIPE,stdout=subprocess.PIPE,stderr=subprocess.DEVNULL)
    deadline=time.monotonic()+120
    pending=b'';status=None
    try:
        while True:
            if time.monotonic()>=deadline:raise ValueError('personal_data_deadline')
            readable,_,_=select.select([process.stdout],[],[],max(0,deadline-time.monotonic()))
            if not readable:raise ValueError('personal_data_deadline')
            block=os.read(process.stdout.fileno(),8192)
            if not block:
                if pending:raise ValueError('invalid_personal_data_protocol')
                break
            pending+=block
            # Status can contain two bounded rows for each of1000 directory owners.
            if len(pending)>16*1024*1024:raise ValueError('invalid_personal_data_protocol')
            while b'\n' in pending:
                line,pending=pending.split(b'\n',1)
                message=json.loads(line)
                if isinstance(message,dict) and message.get('binding_check') is True:
                    allow=False
                    try:
                        actual,available=discover(agent.redis_connect(use_replica=True),Ldapproxy(),os.environ['CZERO_USER_DOMAIN'])
                        allow=(read()==config and credentials_unchanged(secret,credentials_snapshot) and actual==snapshot['provider_id'] and all(
                            not config[k] or config[k] in {v['id'] for v in available[k]} for k in ('nethvoice','webtop')) and current_directory_owner(
                                client,parameters['schema'],snapshot['directory'],message))
                    except (ValueError,TypeError,KeyError):pass
                    process.stdin.write(json.dumps({'allow':allow}).encode()+b'\n');process.stdin.flush()
                elif isinstance(message,dict):status=message
                else:raise ValueError('invalid_personal_data_protocol')
        if process.wait(timeout=max(1,deadline-time.monotonic())) or status is None:
            raise ValueError('personal_data_runner_failed')
    finally:
        if process.poll() is None:process.terminate()
        process.stdin.close();process.stdout.close()
    if status is None:raise ValueError('personal_data_runner_failed')
    private_write(state/'personal-data-status.json',status)
    # Detailed per-user coverage belongs in the private state/API, not journald.
    json.dump({key:status[key] for key in ('status','pending_cleanup') if key in status},sys.stdout)
except Exception:
    # Preserve the previous snapshot/checkpoints on partial directory or failed reads.
    try:
        old=json.loads((state/'personal-data-status.json').read_text()) if (state/'personal-data-status.json').exists() else {}
        private_write(state/'personal-data-status.json',{**old,'status':'degraded','error_code':'source_unavailable'})
    except (ValueError,OSError):
        pass
    print('Personal data reconciliation unavailable; previous content retained',file=sys.stderr)
    sys.exit(1)

finally:
    if credentials_copy is not None:credentials_copy.unlink(missing_ok=True)
    if invocation is not None:
        invocation.unlink(missing_ok=True)
        cidfile=invocation.with_suffix('.cid')
        if cidfile.exists():
            identifier=cidfile.read_text().strip()
            if re.fullmatch(r'[0-9a-f]{64}',identifier):
                subprocess.run(['podman','rm','--ignore','-f',identifier],stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=20)
            cidfile.unlink(missing_ok=True)
