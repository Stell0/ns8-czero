import os
from pathlib import Path
import agent

state = Path(os.environ['AGENT_STATE_DIR'])
private = state/'auth.env'
old_umask = os.umask(0o077)
try:
    if not private.exists():
        with agent.safe_open(str(private)) as output:
            output.write('')
finally:
    os.umask(old_umask)
private.chmod(0o600)
