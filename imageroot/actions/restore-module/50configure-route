import json
import os
import sys
from pathlib import Path
import agent

original = json.load(sys.stdin)['environment']
host = original.get('CZERO_HOST','').lower()
module_id = os.environ['MODULE_ID']
state = Path(os.environ['AGENT_STATE_DIR'])
receipt_path = state / 'restore-receipt.json'
receipt = json.loads(receipt_path.read_text()) if receipt_path.exists() else {}
previous = (state / 'restore-previous-host').read_text()
own_route = receipt.get('module_id') == module_id and receipt.get('host') == host and previous == host
if host and not own_route and agent.http_route_in_use(domain=host):
    print('C0 restore hostname is in use; restore into a clean module slot',file=sys.stderr)
    sys.exit(1)
route = {'instance':module_id,'url':'http://127.0.0.1:'+os.environ['TCP_PORT'],
    'host':host or None,'path':None if host else '/czero/'+module_id,
    'http2https':bool(host),'lets_encrypt':original.get('CZERO_LETS_ENCRYPT','false')=='true'}
agent.set_route(route)

receipt.update({'module_id':module_id,'host':host})
with agent.safe_open(str(receipt_path)) as output:
    json.dump(receipt,output)
receipt_path.chmod(0o600)
