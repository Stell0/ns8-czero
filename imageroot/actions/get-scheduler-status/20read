import json
import subprocess
import sys


def check(operation,unit):
    return subprocess.run(['systemctl','--user',operation,'--quiet',unit],
                          stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL).returncode==0


worker=subprocess.run(['systemctl','--user','show','--property=ActiveState','--value','czero-worker.service'],
                      capture_output=True,text=True,check=True).stdout.strip()
json.dump({'timer_active':check('is-active','czero-worker.timer'),
    'timer_enabled':check('is-enabled','czero-worker.timer'),
    'worker_running':worker in ('active','activating','reloading'),
    'worker_failed':check('is-failed','czero-worker.service')},sys.stdout)
