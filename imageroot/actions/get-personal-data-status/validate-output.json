{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "status": {
            "enum": [
                "disabled",
                "unverified",
                "busy",
                "degraded",
                "source_unavailable",
                "provider_mismatch"
            ]
        },
        "error_code": {
            "enum": [
                "source_unavailable"
            ]
        },
        "pending_cleanup": {
            "type": "integer",
            "minimum": 0
        },
        "pending_payload_cleanup": {
            "type": "integer",
            "minimum": 0
        },
        "deletion_coverage": {
            "enum": [
                "not_authoritative"
            ]
        },
        "users": {
            "type": "array",
            "maxItems": 1000,
            "items": {
                "type": "object",
                "properties": {
                    "username": {
                        "type": "string",
                        "maxLength": 128
                    },
                    "connector": {
                        "enum": [
                            "nethvoice",
                            "webtop"
                        ]
                    },
                    "status": {
                        "enum": [
                            "unverified",
                            "backfill",
                            "partial",
                            "suspended",
                            "degraded",
                            "reconciled"
                        ]
                    },
                    "last_success": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "last_inventory": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "error_code": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 64
                    },
                    "cursor": {
                        "type": "object",
                        "properties": {
                            "page": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "folder_index": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "documents": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "skipped": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "scan_skipped": {
                                "type": "integer",
                                "minimum": 0
                            },
                            "window_start": {
                                "type": "string",
                                "maxLength": 128
                            },
                            "window_end": {
                                "type": "string",
                                "maxLength": 128
                            },
                            "scan_id": {
                                "type": "string",
                                "maxLength": 128
                            },
                            "inventory_hash": {
                                "type": "string",
                                "maxLength": 128
                            },
                            "folder_hash": {
                                "type": "string",
                                "maxLength": 128
                            },
                            "read_verified": {
                                "type": "boolean"
                            }
                        },
                        "additionalProperties": false
                    },
                    "inventory_overdue": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "username",
                    "connector",
                    "status"
                ],
                "additionalProperties": false
            }
        },
        "attachment_issues": {
            "type": "object",
            "additionalProperties": {
                "type": "integer",
                "minimum": 0
            }
        },
        "imports": {
            "type": "object",
            "properties": {
                "managed": {
                    "type": "integer",
                    "minimum": 0
                },
                "overridden": {
                    "type": "integer",
                    "minimum": 0
                },
                "excluded": {
                    "type": "integer",
                    "minimum": 0
                },
                "cleanup": {
                    "type": "integer",
                    "minimum": 0
                },
                "removed": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        },
        "extraction": {
            "type": "object",
            "properties": {
                "queued": {
                    "type": "integer",
                    "minimum": 0
                },
                "ready": {
                    "type": "integer",
                    "minimum": 0
                },
                "failed": {
                    "type": "integer",
                    "minimum": 0
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
