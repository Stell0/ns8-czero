{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "configure-module input",
    "$id": "http://schema.nethserver.org/czero/configure-module-input.json",
    "description": "Configure czero",
    "examples": [
        {
            "host": "c0.example.test",
            "lets_encrypt": false
        }
    ],
    "type": "object",
    "properties": {
        "host": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$",
            "description": "Application DNS hostname, without scheme or path",
            "not": {
                "pattern": "\\s"
            }
        },
        "lets_encrypt": {
            "type": "boolean",
            "default": false,
            "description": "Request a certificate through NS8 Traefik"
        },
        "user_domain": {
            "type": "string",
            "maxLength": 253,
            "not": {
                "pattern": "\\s"
            }
        },
        "idp": {
            "type": "string",
            "maxLength": 36,
            "pattern": "^$|^[A-Fa-f0-9]{8}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{4}-[A-Fa-f0-9]{12}$"
        },
        "owner": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.@-]*$"
        },
        "retrieval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "embedding": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "maxLength": 2048
                        },
                        "model": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "api_key": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "clear_api_key": {
                            "type": "boolean"
                        },
                        "timeout": {
                            "type": "number",
                            "minimum": 0.05,
                            "maximum": 5
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "dimensions": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2000
                        },
                        "send_dimensions": {
                            "type": "boolean"
                        }
                    }
                },
                "scorer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "maxLength": 2048
                        },
                        "model": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "api_key": {
                            "type": "string",
                            "maxLength": 4096
                        },
                        "clear_api_key": {
                            "type": "boolean"
                        },
                        "timeout": {
                            "type": "number",
                            "minimum": 0.05,
                            "maximum": 5
                        },
                        "mode": {
                            "enum": [
                                "off",
                                "rerank",
                                "filter"
                            ]
                        },
                        "threshold": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        }
                    }
                },
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "max_limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                        },
                        "candidates": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 64
                        },
                        "graph_depth": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3
                        },
                        "scorer_candidates": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 16
                        }
                    }
                }
            }
        },
        "session_policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "absolute_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 86400
                },
                "idle_seconds": {
                    "type": "integer",
                    "minimum": 60,
                    "maximum": 86400
                }
            },
            "description": "New sign-in absolute/inactivity bounds; idle must not exceed absolute"
        },
        "cimd_enabled": {
            "type": "boolean",
            "description": "Allow administrator-approved public OAuth client metadata URLs; disabled by default"
        },
        "connection_idle_seconds": {
            "type": "integer",
            "minimum": 86400,
            "maximum": 31536000,
            "multipleOf": 86400
        }
    },
    "additionalProperties": false,
    "required": [
        "host"
    ]
}
