{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "configure-module input",
    "$id": "http://schema.nethserver.org/czero/configure-module-input.json",
    "description": "Configure czero",
    "examples": [
        {
            "host": "c0.example.test",
            "lets_encrypt": false
        }
    ],
    "type": "object",
    "properties": {
        "host": {
            "type": "string",
            "minLength": 3,
            "maxLength": 253,
            "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?\\.)+[A-Za-z](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?$",
            "description": "Application DNS hostname, without scheme or path",
            "not": {
                "pattern": "\\s"
            }
        },
        "lets_encrypt": {
            "type": "boolean",
            "default": false,
            "description": "Request a certificate through NS8 Traefik"
        }
    },
    "additionalProperties": false,
    "required": [
        "host"
    ]
}
