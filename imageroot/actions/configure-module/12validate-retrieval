import json
import os
from pathlib import Path
import sys
import agent
sys.path.insert(0, str(Path(os.environ['AGENT_INSTALL_DIR']) / 'bin'))
from czero_retrieval_config import read, merge, encode

state = Path(os.environ['AGENT_STATE_DIR'])
pending = state / 'retrieval-pending.env'
pending.unlink(missing_ok=True)
try:
    request = json.load(sys.stdin)
    updated = merge(read(state / 'retrieval.env'), request.get('retrieval', {}))
    old_umask = os.umask(0o077)
    try:
        with agent.safe_open(str(pending)) as output:
            output.write(encode(updated))
        pending.chmod(0o600)
    finally:
        os.umask(old_umask)
except (OSError, ValueError, TypeError, KeyError, RecursionError):
    agent.set_status('validation-failed')
    json.dump([{'field': 'retrieval', 'parameter': 'retrieval',
                'error': 'invalid_retrieval_configuration'}], sys.stdout)
    sys.exit(2)
