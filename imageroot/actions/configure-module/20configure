import json
import os
import sys
import agent

json.load(sys.stdin)
module_id = os.environ["MODULE_ID"]
# This is a non-secret instance identity used by the app to mount its routes
# below the path owned by this NS8 module.
agent.set_env("CZERO_MODULE_ID", module_id)
# Core removes this instance-owned route when the module is removed.
agent.set_route({
    "instance": module_id,
    "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
    "http2https": False,
    "lets_encrypt": False,
    "path": "/czero/" + module_id,
})
