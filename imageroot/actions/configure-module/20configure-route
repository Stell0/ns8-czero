import json
import os
import sys
import agent

data = json.load(sys.stdin)
# Traefik merges existing route data: null removes the M01 path constraint.
# Persist settings only after native route/certificate validation succeeds.
agent.set_route({
    "instance": os.environ["MODULE_ID"],
    "url": "http://127.0.0.1:" + os.environ["TCP_PORT"],
    "host": data["host"].lower(),
    "path": None,
    "http2https": True,
    "lets_encrypt": data.get("lets_encrypt", False),
})
