import json
import os
from pathlib import Path
import re
import sys
import agent
import agent.tasks

state = Path(os.environ['AGENT_STATE_DIR'])
settings = json.loads((state/'auth-pending.json').read_text())
credentials = {}
if settings['domain']:
    origin = 'https://'+settings['host']
    response = agent.tasks.run('module/'+settings['provider_id'],action='register-client',data={
        'domain':settings['domain'], 'redirect_uris':[origin+'/auth/callback'],
        'post_logout_redirect_uris':[origin+'/'], 'web_origins':[],
        'audience':[os.environ['MODULE_ID']],
    })
    result = response.get('output')
    if response.get('exit_code') != 0 or not isinstance(result,dict):
        print('OIDC client registration failed; check the selected identity provider',file=sys.stderr)
        sys.exit(1)
    secret = result.get('client_secret','')
    if result.get('client_id') != os.environ['MODULE_ID'] or result.get('issuer') != settings['issuer'] or not re.fullmatch(r'[A-Za-z0-9_-]{1,256}',secret):
        print('OIDC client registration returned invalid credentials',file=sys.stderr)
        sys.exit(1)
    credentials = {'CZERO_OIDC_ISSUER':settings['issuer'],'CZERO_OIDC_CLIENT_ID':result['client_id'],
        'CZERO_OIDC_CLIENT_SECRET':secret,'CZERO_AUTH_PUBLIC_ORIGIN':origin,
        'CZERO_OWNER_LDAP_UUID':settings['owner_key']}
old_umask = os.umask(0o077)
try:
    agent.write_envfile(str(state/'auth.env'),credentials)
finally:
    os.umask(old_umask)
(state/'auth.env').chmod(0o600)
agent.set_env('CZERO_OIDC_HOST_OPTION',settings.get('host_option',''))
