import json
import os
import re
from pathlib import Path
import sys
from urllib.parse import urlsplit
from uuid import UUID

import agent
from agent.ldapproxy import Ldapproxy
from agent.ldapclient import Ldapclient


def fail(field, error):
    agent.set_status('validation-failed')
    json.dump([{'field':field,'parameter':field,'error':error}],sys.stdout)
    sys.exit(2)


request = json.load(sys.stdin)
domain = request.get('user_domain',os.getenv('CZERO_USER_DOMAIN',''))
provider_uuid = request.get('idp',os.getenv('CZERO_IDP_UUID',''))
owner = request.get('owner',os.getenv('CZERO_OWNER_USERNAME',''))
staged = {'domain':domain,'provider_uuid':provider_uuid,'owner':owner,
          'owner_key':'','provider_id':'','issuer':'','host_option':'',
          'host':request.get('host',os.getenv('CZERO_HOST','')).lower()}
if any((domain,provider_uuid,owner)):
    if not all((domain,provider_uuid,owner)):
        fail('user_domain','identity_configuration_incomplete')
    providers = agent.list_service_providers(agent.redis_connect(use_replica=True),'oidc','http',{'module_uuid':provider_uuid})
    if len(providers) != 1:
        fail('idp','identity_provider_unavailable')
    provider = providers[0]
    prefix = provider.get('issuer_url_prefix','')
    url = urlsplit(prefix)
    if url.scheme != 'https' or not url.hostname or url.username or url.password or url.query or url.fragment or not prefix.endswith('/'):
        fail('idp','identity_provider_invalid')
    if str(provider.get('node','')) == os.getenv('NODE_ID','') and os.getenv('NODE_ID'):
        if len(url.hostname) > 253 or not re.fullmatch(r'(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?',url.hostname):
            fail('idp','identity_provider_invalid')
        staged['host_option'] = '--add-host='+url.hostname+':10.0.2.2'
    parameters = Ldapproxy().get_domain(domain)
    if not parameters:
        fail('user_domain','user_domain_unavailable')
    previous_key = os.getenv('CZERO_OWNER_LDAP_UUID','')
    if previous_key and owner == os.getenv('CZERO_OWNER_USERNAME') and domain == os.getenv('CZERO_USER_DOMAIN'):
        try:
            owner_key = str(UUID(previous_key))
        except ValueError:
            fail('owner','owner_identity_invalid')
    else:
        attribute = 'objectGUID' if parameters['schema'] == 'ad' else 'entryUUID'
        try:
            entry = Ldapclient.factory(**parameters).get_user_entry(owner,lextra_attributes=[attribute])
            value = entry['attributes'][attribute]
            value = value[0] if isinstance(value,list) else value
            if isinstance(value,bytes):
                owner_key = str(UUID(bytes_le=value)) if attribute == 'objectGUID' else str(UUID(value.decode('ascii')))
            else:
                owner_key = str(UUID(str(value)))
            attributes = entry['attributes']
            if attributes.get('pwdAccountLockedTime') or (attributes.get('userAccountControl',0) or 0) & 2:
                fail('owner','owner_account_locked')
        except Exception:
            fail('owner','owner_identity_unavailable')
    staged.update({'owner_key':owner_key,'provider_id':provider['module_id'],'issuer':prefix+domain})
state = Path(os.environ['AGENT_STATE_DIR'])
old_umask = os.umask(0o077)
try:
    with agent.safe_open(str(state/'auth-pending.json')) as output:
        json.dump(staged,output)
finally:
    os.umask(old_umask)
(state/'auth-pending.json').chmod(0o600)
