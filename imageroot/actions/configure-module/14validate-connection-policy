import json
import os
from pathlib import Path
import sys
import agent

sys.path.insert(0, str(Path(os.environ['AGENT_INSTALL_DIR']) / 'bin'))
from czero_connection_policy import read, validate

try:
    validate(json.load(sys.stdin).get('connection_idle_seconds', read()))
except (ValueError, TypeError):
    agent.set_status('validation-failed')
    json.dump([{'field': 'connection_idle_seconds', 'parameter': 'connection_idle_seconds',
                'error': 'invalid_connection_policy'}], sys.stdout)
    sys.exit(2)
