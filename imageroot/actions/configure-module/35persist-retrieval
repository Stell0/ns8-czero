import os
from pathlib import Path
import agent
import sys
sys.path.insert(0, str(Path(os.environ['AGENT_INSTALL_DIR']) / 'bin'))
from czero_retrieval_config import read, encode

state = Path(os.environ['AGENT_STATE_DIR'])
pending = state / 'retrieval-pending.env'
if not pending.exists():
    raise SystemExit('Missing validated retrieval configuration')
updated = read(pending)
old_umask = os.umask(0o077)
try:
    with agent.safe_open(str(state / 'retrieval.env')) as output:
        output.write(encode(updated))
    (state / 'retrieval.env').chmod(0o600)
    pending.unlink()
finally:
    os.umask(old_umask)
