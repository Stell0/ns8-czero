"""Native Admin credential input; no personal passwords or source writes."""
import base64,json,os,re,sys
from pathlib import Path
from uuid import UUID
import agent
from agent.ldapclient import Ldapclient
from agent.ldapproxy import Ldapproxy
sys.path.insert(0,str(Path(os.environ['AGENT_INSTALL_DIR'])/'bin'))
from czero_personal_data import read,private_write,discover
try:
    value=json.load(sys.stdin)
    kind=value['connector'];instance=str(UUID(value['instance_id']))
    config=read()
    if kind not in ('nethvoice','webtop') or config.get(kind)!=instance:raise ValueError()
    _,options=discover(agent.redis_connect(use_replica=True),Ldapproxy(),os.environ['CZERO_USER_DOMAIN'])
    if instance not in {v['id'] for v in options[kind]}:raise ValueError()
    path=Path(os.environ['AGENT_STATE_DIR'])/'personal-data-secrets.json'
    saved=json.loads(path.read_text()) if path.exists() else {}
    entry=saved.setdefault(kind,{}).setdefault(instance,{})
    clear=value.get('clear',False)
    secret=value.get('secret','')
    if not clear and (not isinstance(secret,str) or not secret or len(secret)>16384 or not secret.isascii() or any(c.isspace() for c in secret)):
        raise ValueError()
    if kind=='nethvoice':
        username=value['username']
        parameters=Ldapproxy().get_domain(os.environ['CZERO_USER_DOMAIN'])
        attribute='objectGUID' if parameters['schema']=='ad' else 'entryUUID'
        attrs=Ldapclient.factory(**parameters).get_user_entry(username,lextra_attributes=[attribute])['attributes']
        identifier=attrs[attribute];identifier=identifier[0] if isinstance(identifier,list) else identifier
        if isinstance(identifier,bytes):identifier=UUID(bytes_le=identifier) if attribute=='objectGUID' else UUID(identifier.decode('ascii'))
        else:identifier=UUID(str(identifier))
        users=entry.setdefault('users',{})
        if clear:users.pop(str(identifier),None)
        else:
            if len(secret.split('.'))!=3:raise ValueError()
            payload=secret.split('.')[1]
            claims=json.loads(base64.urlsafe_b64decode(payload+'='*(-len(payload)%4)))
            if claims.get('id')!=username:raise ValueError()
            users[str(identifier)]=secret
    else:
        if clear:
            entry.pop('api_key',None)
            entry['revocation_pending']=True
        else:
            # The installed domain-key format differs from the all-alphanumeric
            # provisioning token. Never accept that existing super-admin token.
            if not re.fullmatch(r'[A-Za-z0-9_-]{8,128}_[A-Za-z0-9_-]{8,128}',secret):raise ValueError()
            entry['api_key']=secret
            entry['revocation_pending']=False
    if len(json.dumps(saved).encode())>1024*1024:raise ValueError()
    private_write(path,saved)
    json.dump({'saved':True,'verified':False,'revocation_pending':bool(clear)},sys.stdout)
except Exception:
    agent.set_status('validation-failed')
    json.dump([{'field':'secret','parameter':'secret','error':'personal_credential_invalid_or_binding_changed'}],sys.stdout)
    sys.exit(2)
