{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "connector": {
            "enum": [
                "nethvoice",
                "webtop"
            ]
        },
        "instance_id": {
            "type": "string",
            "format": "uuid"
        },
        "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
        },
        "secret": {
            "type": "string",
            "maxLength": 16384,
            "writeOnly": true
        },
        "clear": {
            "type": "boolean"
        }
    },
    "required": [
        "connector",
        "instance_id"
    ]
}
