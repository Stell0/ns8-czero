import os
import json
import sys
import agent
from pathlib import Path
sys.path.insert(0, str(Path(os.environ['AGENT_INSTALL_DIR']) / 'bin'))
from czero_retrieval_config import read, public
from czero_session_policy import read as session_policy
from czero_connection_policy import read as connection_policy
from czero_cimd_config import read as cimd_enabled

config = {"host": os.getenv("CZERO_HOST", ""),
          "lets_encrypt": os.getenv("CZERO_LETS_ENCRYPT", "false").lower() == "true",
          "user_domain":os.getenv('CZERO_USER_DOMAIN',''),"idp":os.getenv('CZERO_IDP_UUID',''),
          "owner":os.getenv('CZERO_OWNER_USERNAME',''),"owner_ldap_uuid":os.getenv('CZERO_OWNER_LDAP_UUID','')}

config['retrieval'] = public(read(Path(os.environ['AGENT_STATE_DIR']) / 'retrieval.env'))
config['session_policy'] = session_policy()
config['connection_idle_seconds'] = connection_policy()
config['cimd_enabled'] = cimd_enabled()
json.dump(config, fp=sys.stdout)
