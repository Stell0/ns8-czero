{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "get-configuration output",
    "$id": "http://schema.nethserver.org/czero/get-configuration-output.json",
    "description": "Get czero configuration",
    "examples": [],
    "type": "object",
    "properties": {
        "host": {
            "type": "string"
        },
        "lets_encrypt": {
            "type": "boolean"
        },
        "user_domain": {
            "type": "string"
        },
        "idp": {
            "type": "string"
        },
        "owner": {
            "type": "string"
        },
        "owner_ldap_uuid": {
            "type": "string"
        },
        "retrieval": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "embedding": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "maxLength": 2048
                        },
                        "model": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "timeout": {
                            "type": "number",
                            "minimum": 0.05,
                            "maximum": 5
                        },
                        "enabled": {
                            "type": "boolean"
                        },
                        "dimensions": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 2000
                        },
                        "send_dimensions": {
                            "type": "boolean"
                        },
                        "api_key_configured": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "endpoint",
                        "model",
                        "timeout",
                        "enabled",
                        "dimensions",
                        "send_dimensions",
                        "api_key_configured"
                    ]
                },
                "scorer": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "endpoint": {
                            "type": "string",
                            "maxLength": 2048
                        },
                        "model": {
                            "type": "string",
                            "maxLength": 128
                        },
                        "timeout": {
                            "type": "number",
                            "minimum": 0.05,
                            "maximum": 5
                        },
                        "mode": {
                            "enum": [
                                "off",
                                "rerank",
                                "filter"
                            ]
                        },
                        "threshold": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                        },
                        "api_key_configured": {
                            "type": "boolean"
                        }
                    },
                    "required": [
                        "endpoint",
                        "model",
                        "timeout",
                        "mode",
                        "threshold",
                        "api_key_configured"
                    ]
                },
                "limits": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "max_limit": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 50
                        },
                        "candidates": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 64
                        },
                        "graph_depth": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 3
                        },
                        "scorer_candidates": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 16
                        }
                    },
                    "required": [
                        "max_limit",
                        "candidates",
                        "graph_depth",
                        "scorer_candidates"
                    ]
                }
            },
            "required": [
                "embedding",
                "scorer",
                "limits"
            ]
        }
    },
    "additionalProperties": false,
    "required": [
        "host",
        "lets_encrypt",
        "user_domain",
        "idp",
        "owner",
        "owner_ldap_uuid",
        "retrieval"
    ]
}
