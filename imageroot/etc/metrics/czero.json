{
  "uid": "czero-__MODULE_ID__",
  "title": "C0 – __MODULE_ID__",
  "description": "C0 activity, knowledge, background processing, and resources for __MODULE_ID__.",
  "tags": [
    "C0",
    "NS8"
  ],
  "schemaVersion": 39,
  "version": 0,
  "editable": false,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "C0 services",
      "description": "Local systemd state. Missing or stale collection leaves this panel without a value.",
      "gridPos": {
        "h": 4,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Inactive",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Active",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "czero_service_up{module=\"__MODULE_ID__\"} and on (module, node, job) (time() - czero_collection_timestamp_seconds{module=\"__MODULE_ID__\"} < 900)",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ]
    },
