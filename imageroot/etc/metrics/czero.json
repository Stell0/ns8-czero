        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "60 * sum by (outcome) (rate(czero_mcp_calls_total{module=\"__MODULE_ID__\"}[15m]) and on (module, node, job) (time() - czero_collection_timestamp_seconds{module=\"__MODULE_ID__\"} < 900))",
          "legendFormat": "{{outcome}}",
          "instant": false,
          "range": true
        }
      ]
