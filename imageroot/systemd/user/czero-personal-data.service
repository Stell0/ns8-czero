[Unit]
Description=C0 personal data reconciliation
PartOf=czero.service czero-pod.service
Requisite=czero.service
After=czero.service czero-postgres.service

[Service]
Type=oneshot
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
TimeoutStartSec=150
TimeoutStopSec=20
ExecStart=%E/bin/czero-personal-data-run
ExecStopPost=-/usr/bin/podman rm --ignore -f czero-personal-data-run
SyslogIdentifier=%N
