#
# This systemd unit starts a czero instance using Podman.
# Most parts of this file come from podman-generate-systemd.
#
[Unit]
Description=C0 application service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
ExecStartPre=/bin/rm -f %t/czero.pid %t/czero.ctr-id
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/czero.pid \
    --cidfile=%t/czero.ctr-id \
    --cgroups=no-conmon \
    --replace --name=%N \
    --publish=127.0.0.1:${TCP_PORT}:8080 \
    --env=CZERO_MODULE_ID=${CZERO_MODULE_ID} \
    --env=CZERO_BASE_PATH=${CZERO_BASE_PATH} \
    ${CZERO_APP_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/czero.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/czero.ctr-id
PIDFile=%t/czero.pid
Type=forking

[Install]
WantedBy=default.target
