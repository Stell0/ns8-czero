[Unit]
Description=C0 five minute personal data reconciliation
DefaultDependencies=no
Conflicts=shutdown.target
Before=shutdown.target
PartOf=czero.service
Requisite=czero.service
After=czero.service

[Timer]
OnActiveSec=1min
OnUnitInactiveSec=5min
AccuracySec=5s
Unit=czero-personal-data.service

[Install]
WantedBy=czero.service
