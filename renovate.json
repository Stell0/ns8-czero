{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "matchDatasources": [
        "github-tags"
      ],
      "matchPackageNames": [
        "Stell0/ns8-czero"
      ],
      "versioning": "regex:^core-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
      "allowedVersions": ">=core-v0.25.0 <core-v0.26.0",
      "automerge": false
    }
  ]
}
