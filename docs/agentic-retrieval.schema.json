{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/c0/agentic-retrieval-config",
  "title": "Private agentic retrieval configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "cli_version": {
      "enum": [
        "codex-cli 0.163.0",
        "codex-cli 0.166.0"
      ]
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,30}$"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "improvement",
        "disposition",
        "p95_seconds"
      ],
      "properties": {
        "complete": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "improvement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "disposition": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "p95_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 180
        }
      }
    },
    "calls": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "context_bytes": {
      "type": "integer",
      "minimum": 16384,
      "maximum": 1048576
    },
    "episode_tokens": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 500000
    },
    "episode_seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 180
    },
    "sessions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "tokens": {
      "type": "integer",
      "minimum": 10000,
      "maximum": 30000000
    },
    "seconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 21600
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "questions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "layer_records": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "mode": {
      "enum": [
        "benchmark",
        "optimize"
      ]
    },
    "max_sources": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "max_source_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "batch_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "source_packet_bytes": {
      "type": "integer",
      "minimum": 16384,
      "maximum": 524288
    },
    "question_counts": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "answerable",
            "ambiguous",
            "unanswerable"
          ],
          "properties": {
            "answerable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "ambiguous": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            },
            "unanswerable": {
              "type": "integer",
              "minimum": 0,
              "maximum": 500
            }
          }
        }
      ]
    }
  }
}
